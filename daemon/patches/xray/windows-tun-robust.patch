+// defaultRouteInterfaceIndex — интерфейс маршрута IPv4 по умолчанию с
+// наименьшей полной метрикой, не считая самого адаптера туннеля.
+func defaultRouteInterfaceIndex(tunIndex int) (int, bool) {
+	table, err := winipcfg.GetIPForwardTable2(windows.AF_INET)
+	if err != nil {
+		return 0, false
+	}
+	best, bestMetric := 0, ^uint64(0)
+	for i := range table {
+		row := &table[i]
+		if int(row.InterfaceIndex) == tunIndex || row.DestinationPrefix.Prefix().Bits() != 0 {
+			continue
+		}
+		if hop := row.NextHop.Addr(); !hop.Is4() || hop.IsUnspecified() {
+			continue
+		}
+		metric := uint64(row.Metric)
+		if ipif, err := row.InterfaceLUID.IPInterface(windows.AF_INET); err == nil {
+			if !ipif.Connected {
+				continue
+			}
+			metric += uint64(ipif.Metric)
+		}
+		if metric < bestMetric {
+			best, bestMetric = int(row.InterfaceIndex), metric
+		}
+	}
+	return best, bestMetric != ^uint64(0)
+}
