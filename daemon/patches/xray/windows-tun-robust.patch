+// Так же поступает официальный клиент WireGuard (tunnel/addressconfig.go).
+func retryNotFound(step func() error) error {
+	var err error
+	for attempt := 0; attempt < 25; attempt++ {
+		if err = step(); !go_errors.Is(err, windows.ERROR_NOT_FOUND) {
+			return err
 		}
+		time.Sleep(200 * time.Millisecond)
 	}
+	return err
