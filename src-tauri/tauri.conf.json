{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustleBoost",
  "version": "1.3.4",
  "identifier": "com.rustleboost.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "RustleBoost",
        "width": 380,
        "height": 660,
        "minWidth": 340,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "RustleBoost",
    "copyright": "Copyright (c) 2026 RustleBoost. MIT License.",
    "homepage": "https://github.com/gministr/rustleboost",
    "category": "Utility",
    "license": "MIT",
    "shortDescription": "VPN client",
    "longDescription": "RustleBoost is an open-source VPN client for Windows built on the sing-box and Xray cores. Source code: https://github.com/gministr/rustleboost",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/daemon-x86_64-pc-windows-msvc.exe": "daemon.exe",
      "binaries/sing-box-x86_64-pc-windows-msvc.exe": "sing-box.exe",
      "binaries/xray-x86_64-pc-windows-msvc.exe": "xray.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDQjQ3OTA0NjE1NkE1NEIKUldSTHBWWmhCSG0wWEIwVElCOGIybU1mVmhEUmhiQ3JhNGVsZnN6LzQwdnBrb3k3YnU2QVhtSEEK",
      "endpoints": [
        "https://github.com/gministr/rustleboost/releases/latest/download/latest.json"
      ]
    }
  }
}

